<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.donsu.local-nagger</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/donsu/local-nagger/.venv/bin/python3</string>
        <string>-m</string>
        <string>local_nagger.checker</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/donsu/local-nagger</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/donsu/local-nagger</string>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>StandardOutPath</key>
    <string>/Users/donsu/local-nagger/data/checker.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/donsu/local-nagger/data/checker.err.log</string>
</dict>
</plist>
