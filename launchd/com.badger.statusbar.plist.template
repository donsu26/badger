<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.badger.statusbar</string>

    <key>ProgramArguments</key>
    <array>
        <string>__BADGER_DIR__/bin/statusbar</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__BADGER_DIR__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>StandardOutPath</key>
    <string>__BADGER_DIR__/data/statusbar.log</string>

    <key>StandardErrorPath</key>
    <string>__BADGER_DIR__/data/statusbar.err.log</string>
</dict>
</plist>
