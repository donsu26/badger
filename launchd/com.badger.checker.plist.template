<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.badger.checker</string>

    <key>ProgramArguments</key>
    <array>
        <string>__BADGER_DIR__/.venv/bin/python3</string>
        <string>-m</string>
        <string>badger.checker</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>__BADGER_DIR__</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>__BADGER_DIR__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>StandardOutPath</key>
    <string>__BADGER_DIR__/data/checker.log</string>

    <key>StandardErrorPath</key>
    <string>__BADGER_DIR__/data/checker.err.log</string>
</dict>
</plist>
